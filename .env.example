# Copy to .env and fill in. Never commit .env.
AI_PROVIDER=gemini                 # gemini (real) | mock (offline tests only - not a vision model)
GEMINI_API_KEY=your-ai-studio-key  # free, no card: https://aistudio.google.com/apikey
VISION_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
PEXELS_API_KEY=your-pexels-key     # free, no card: https://www.pexels.com/api/ (only for scripts/download_images.py)

# DATABASE_URL is set by docker-compose; for running without Docker:
# DATABASE_URL=sqlite:///./data/app.db
IMAGES_DIR=./data/images

# Mismatch guard (tune with: python -m scripts.eval --sweep)
MIN_CONFIDENCE=0.60
SIMILARITY_THRESHOLD=0.62
SUBJECT_SIMILARITY=0.85

# Cost tracking + budget guard (estimated at paid list prices; free tier = $0 actual)
AI_BUDGET_USD=1.00
VISION_INPUT_USD_PER_M=0.30
VISION_OUTPUT_USD_PER_M=2.50
EMBED_INPUT_USD_PER_M=0.15
MAX_RETRIES=3
